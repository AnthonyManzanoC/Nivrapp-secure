{
  "name": "nivra-multiplatform",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor shell for the Nivra Angular + Ionic frontend served separately from the .NET API.",
  "scripts": {
    "web:start": "npm --prefix nivra-app run start -- --host 127.0.0.1 --port 8100",
    "web:build": "npm --prefix nivra-app run build",
    "cap:init": "npx cap init Nivra com.nivra.app --web-dir nivra-app/dist/nivra-app/browser",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor-firebase/messaging": "^8.2.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/status-bar": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4"
  }
}
