{
  "headers": [
    {
      "source": "/assets/release.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/updates/latest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/downloads/Nivra-:version([0-9]+[.][0-9]+[.][0-9]+)-debug.apk",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/downloads/Nivra-:version([0-9]+[.][0-9]+[.][0-9]+)-Setup.exe",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/updates/latest.json",
      "destination": "/api/updates"
    },
    {
      "source": "/downloads/Nivra-:version([0-9]+[.][0-9]+[.][0-9]+)-debug.apk",
      "destination": "https://github.com/AnthonyManzanoC/Nivrapp-secure/releases/download/v:version/Nivra-:version-debug.apk"
    },
    {
      "source": "/downloads/Nivra-:version([0-9]+[.][0-9]+[.][0-9]+)-Setup.exe",
      "destination": "/api/download-windows?version=:version"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/updates.js": {
      "maxDuration": 30
    },
    "api/download-windows.js": {
      "maxDuration": 300
    }
  }
}
